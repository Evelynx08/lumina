{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "identifier": "com.bookos.lumina",
  "productName": "bookos-lumina",
  "mainBinaryName": "bookos-lumina",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "deb",
      "rpm"
    ],
    "publisher": "BookOS",
    "category": "SocialNetworking",
    "linux": {
      "deb": {
        "depends": [
          "xdg-utils",
          "libglib2.0-bin"
        ],
        "desktopTemplate": "linux/desktop.hbs",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/bookos-lumina.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "xdg-utils",
          "glib2"
        ],
        "desktopTemplate": "linux/desktop.hbs",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/bookos-lumina.svg": "icons/icon.svg"
        }
      }
    },
    "shortDescription": "Cliente de WhatsApp para BookOS"
  }
}
